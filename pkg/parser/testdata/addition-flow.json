{
  "id": "addition-flow",
  "name": "Addition Flow",
  "runtime": "go",
  "version": "v1.0.0",
  "inputType": {
    "dataType": "object",
    "properties": {
      "a": {
        "dataType": "integer"
      },
      "b": {
        "dataType": "integer"
      }
    }
  },
  "outputType": {
    "dataType": "float"
  },
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "next": "addition"
    },
    {
      "id": "addition",
      "type": "assignment",
      "next": "end",
      "outputType": {
        "dataType": "float"
      },
      "output": "$F.add($INPUT.a, $INPUT.b)"
    },
    {
      "id": "end",
      "type": "end",
      "resultType": "success",
      "output": "$NODE.addition"
    }
  ]
}