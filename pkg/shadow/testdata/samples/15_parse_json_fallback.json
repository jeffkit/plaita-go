{
  "name": "15_parse_json_fallback",
  "description": "parse_json 失败兜底：default 合并 + parse_ok=false + notes 追加明细",
  "input": {
    "text": "no json here"
  },
  "expect": {
    "verdict": "unknown",
    "notes": "fallback；解析失败: no json here",
    "parse_ok": false,
    "parse_error": "解析失败: no json here"
  },
  "flow": {
    "runtime": "python",
    "flow_id": "shadow_s15_parse_json_fallback",
    "inputType": {
      "dataType": "object"
    },
    "nodes": [
      {
        "type": "start",
        "id": "start",
        "next": "pj"
      },
      {
        "type": "parse_json",
        "id": "pj",
        "text": "$INPUT.text",
        "choices": [
          "ok"
        ],
        "default": {
          "verdict": "unknown",
          "notes": "fallback"
        },
        "next": "end"
      },
      {
        "type": "end",
        "id": "end",
        "resultType": "success",
        "output": "$NODE.pj"
      }
    ]
  }
}
