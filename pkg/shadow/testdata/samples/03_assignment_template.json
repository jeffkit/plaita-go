{
  "name": "03_assignment_template",
  "description": "{% ... %} 模板插值（表达式 + 字面花括号），验证两侧门面分发一致",
  "input": {
    "name": "kongjie",
    "n": 6
  },
  "expect": {
    "banner": "Hi kongjie! n=12",
    "literal": "keep {braces} as-is"
  },
  "flow": {
    "runtime": "python",
    "flow_id": "shadow_s03_assignment_template",
    "inputType": {
      "dataType": "object"
    },
    "nodes": [
      {
        "type": "start",
        "id": "start",
        "next": "a"
      },
      {
        "type": "assignment",
        "id": "a",
        "output": {
          "banner": "Hi {% $INPUT.name %}! n={% $F.mul($INPUT.n, 2) %}",
          "literal": "keep {braces} as-is"
        },
        "next": "end"
      },
      {
        "type": "end",
        "id": "end",
        "resultType": "success",
        "output": "$NODE.a"
      }
    ]
  }
}
